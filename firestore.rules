rules_version = '2';

// Each signed-in user can only read and write their own documents under users/{uid}
// (profile, pets, tasks and places). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
