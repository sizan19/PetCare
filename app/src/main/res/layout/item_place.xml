<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:contentPaddingRight="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pc_secondary_container"
            android:importantForAccessibility="no"
            android:padding="12dp"
            app:tint="@color/pc_primary_container"
            tools:src="@drawable/ic_local_hospital_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.PetCare.LabelSmall"
                android:textColor="@color/pc_secondary"
                tools:text="Vet Clinics" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PetCare.TitleSmall"
                tools:text="City Vet Hospital" />

            <TextView
                android:id="@+id/tv_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PetCare.BodySmall"
                tools:text="Main Road, Kathmandu" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_directions"
            style="@style/Widget.PetCare.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_directions"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            app:icon="@drawable/ic_directions_24"
            app:iconPadding="0dp" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_place"
            android:src="@drawable/ic_delete_24"
            app:tint="@color/pc_error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
