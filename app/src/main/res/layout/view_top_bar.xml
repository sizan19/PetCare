<?xml version="1.0" encoding="utf-8"?>
<!-- Shared "PetCare / <tab>" header used at the top of each dashboard tab -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_logo"
        android:scaleType="centerCrop"
        android:src="@drawable/img_petcare_logo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Large" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_name"
            android:textAppearance="@style/TextAppearance.PetCare.TitleLarge"
            android:textColor="@color/pc_primary" />

        <TextView
            android:id="@+id/tv_top_bar_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PetCare.LabelMedium"
            android:textColor="@color/pc_on_surface_variant" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_sign_out"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_sign_out"
        android:src="@drawable/ic_logout_24"
        app:tint="@color/pc_on_surface_variant" />
</LinearLayout>
